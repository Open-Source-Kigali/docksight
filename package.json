{
  "name": "docksight",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Docker management and observability platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@docksight/web",
    "dev:server": "npm run start:dev --workspace=@docksight/server",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@docksight/web",
    "build:server": "npm run build --workspace=@docksight/server",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace=@docksight/server",
    "db:migrate": "npm run prisma:migrate --workspace=@docksight/server",
    "db:studio": "npm run prisma:studio --workspace=@docksight/server",
    "docker:up": "docker compose -f infrastructure/configs/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/configs/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/configs/docker-compose.yml logs -f",
    "docker:infra": "docker compose -f infrastructure/configs/docker-compose.yml up -d",
    "test": "npm run test --workspaces --if-present",
    "test:go": "node scripts/goTest.mjs",
    "test:all": "node scripts/runAllTest.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@oxlint/binding-darwin-arm64": "1.75.0",
    "@oxlint/binding-linux-arm64-musl": "1.75.0",
    "@oxlint/binding-linux-x64-gnu": "1.75.0",
    "@oxlint/binding-linux-x64-musl": "1.75.0",
    "@rolldown/binding-darwin-arm64": "1.1.5",
    "@rolldown/binding-linux-arm64-musl": "1.1.5",
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "@rolldown/binding-linux-x64-musl": "1.1.5",
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-musl": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-linux-arm64-musl": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "license": "MIT"
}
